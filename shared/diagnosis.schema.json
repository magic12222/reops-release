{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reops.local/schemas/diagnosis.schema.json",
  "title": "ReOps Diagnosis",
  "type": "object",
  "required": [
    "schema_version", "diagnosis_id", "incident_id", "trace_id",
    "observation_id", "timestamp", "failure_detected", "failed_component",
    "failed_step", "failure_type", "root_cause", "evidence", "confidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "diagnosis_id": {"type": "string", "minLength": 1},
    "incident_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "case_id": {"type": ["string", "null"]},
    "observation_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "failure_detected": {"type": "boolean"},
    "failed_component": {"type": ["string", "null"]},
    "failed_step": {"type": ["string", "null"]},
    "failure_type": {"type": ["string", "null"]},
    "root_cause": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"failure_detected": {"const": true}}},
      "then": {
        "properties": {
          "failed_component": {"type": "string", "minLength": 1},
          "failed_step": {"type": "string", "minLength": 1},
          "failure_type": {"type": "string", "minLength": 1},
          "root_cause": {"type": "string", "minLength": 1},
          "evidence": {"minItems": 1}
        }
      }
    }
  ],
  "additionalProperties": true
}
